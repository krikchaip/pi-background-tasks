{
  "name": "pi-background-tasks",
  "version": "0.7.4",
  "description": "Pi extension package for tracked background shell tasks: bounded logs, kill/timeout safety, task dock, and completion wakeups.",
  "type": "module",
  "license": "ISC",
  "author": "Ismail <ismailsalikhodjaev@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "background-tasks",
    "coding-agent",
    "shell",
    "tasks"
  ],
  "homepage": "https://github.com/ismailsaleekh/pi-background-tasks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismailsaleekh/pi-background-tasks.git"
  },
  "bugs": {
    "url": "https://github.com/ismailsaleekh/pi-background-tasks/issues"
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "TESTING.md",
    "TEST_PLAN.md",
    "PUBLISHING.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:type-safety": "tsx --test tests/package/type-safety.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:sdk": "tsx --test --test-concurrency=1 tests/sdk/**/*.test.ts",
    "test:rpc": "tsx --test tests/rpc/**/*.test.ts",
    "test:component": "tsx --test tests/component/**/*.test.ts",
    "test:package": "tsx --test tests/package/**/*.test.ts",
    "test": "npm run typecheck && npm run test:type-safety && npm run test:unit && npm run test:sdk && npm run test:rpc && npm run test:component && npm run test:package",
    "test:pty": "tsx --test tests/pty/**/*.test.ts",
    "test:windows": "tsx --test tests/windows/**/*.test.ts",
    "test:agent-loop": "tsx --test --test-concurrency=1 tests/scripted-provider/**/*.test.ts",
    "test:e2e:kitty": "bash tests/e2e/kitty-tmux-pi.sh",
    "test:full": "npm run test && npm run test:pty && npm run test:agent-loop",
    "smoke": "tsx scripts/smoke.ts",
    "pack:dry-run": "npm pack --dry-run",
    "test:compat": "tsx scripts/test-compat.ts",
    "lint": "npm run typecheck && npm run test:type-safety",
    "format:check": "git diff --check"
  },
  "pi": {
    "extensions": [
      "./extensions/background-tasks.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.5 || ^0.81.1 || ^0.82.1 || ^0.83.0 || ^0.84.0",
    "@earendil-works/pi-tui": "^0.75.5 || ^0.81.1 || ^0.82.1 || ^0.83.0 || ^0.84.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
